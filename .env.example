# Vector Observatory Environment Configuration
# Copy to .env and fill in values

# Application
ENVIRONMENT=development
PROJECT_NAME="Vector Observatory"
VERSION=1.0.0

# Database
DATABASE_URL=sqlite:///./data/vector_observatory.db

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost

# LLM (optional - for AI-assisted features)
LLM_API_KEY=
LLM_PROVIDER=openai-compatible
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=

# Keycloak
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=vector-observatory
KEYCLOAK_CLIENT_ID=vector-observatory-client
KEYCLOAK_CLIENT_SECRET=dev-secret-change-in-production

# GitHub (for issue ingestion)
GITHUB_TOKEN=
GITHUB_OWNER=anthropics
GITHUB_REPO=knowledge-work-plugins